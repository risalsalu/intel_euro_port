# NEORIZ Solutions Environment Variables
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets to the repository.

# RESEND API KEY (Required for contact form)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# CONTACT FORM EMAIL CONFIGURATION
# The address that receives the inquiries (Usually support@ or hello@)
CONTACT_EMAIL_TO=support@neorizsolutions.com

# The authenticated sender address (Must be a verified domain in Resend)
CONTACT_EMAIL_FROM=noreply@neorizsolutions.com
